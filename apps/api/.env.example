# ──────────────────────────────────────────────────────────────────────────────
# MTHURA API — environment variables
# Built for the Township Economy · Nkanyezi Tech Solutions (Pty) Ltd
# Copy to .env.local for local development (never commit real credentials)
#
# BUSINESS MODEL: MTHURA earns platform subscriptions ONLY —
# merchants R150/month and drivers R80/month (each after a 30-day trial).
# Launch food payments are EFT + uploaded proof, bank-to-vendor. MTHURA does NOT
# process food payments. Ozow is reserved for subscription billing (future).
# ──────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://kasieats_user:kasieats_password@localhost:5432/kasieats
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://kasieats_user:kasieats_password@localhost:5672

JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:8081

# SMS: console | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_EXPIRY_SECONDS=300

# ─── Platform Subscription Billing (Ozow, future) ─────────────────────────────
# Ozow is reserved for platform subscription payments (merchant R150, driver R80).
# It is NOT used for food order checkout — customers pay vendors via EFT + proof.
#
# PAYMENT_MODE=sandbox  → use mock Ozow flow (safe for dev/test)
# PAYMENT_MODE=production → real Ozow signing (requires OZOW_MERCHANT_ID + OZOW_PRIVATE_KEY)
PAYMENT_MODE=sandbox
OZOW_MERCHANT_ID=
OZOW_PRIVATE_KEY=
OZOW_API_URL=https://pay.ozow.com

# Storage: local | gcs
STORAGE_PROVIDER=local
GCS_BUCKET=
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Maps
GOOGLE_MAPS_API_KEY=
