# ──────────────────────────────────────────────────────────────────────────────
# KasiEats API — environment variables
# Copy to .env.local for local development (never commit real credentials)
# ──────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://kasieats_user:kasieats_password@localhost:5432/kasieats
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://kasieats_user:kasieats_password@localhost:5672

JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:8081

# SMS: console | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_EXPIRY_SECONDS=300

# Payments: sandbox | payfast | yoco
PAYMENT_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
YOCO_SECRET_KEY=

# Storage: local | gcs
STORAGE_PROVIDER=local
GCS_BUCKET=
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Maps
GOOGLE_MAPS_API_KEY=
