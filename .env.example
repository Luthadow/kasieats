# Copy to apps/api/.env.local for local development
DATABASE_URL=postgresql://kasieats_user:kasieats_password@localhost:5432/kasieats
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://kasieats_user:kasieats_password@localhost:5672
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:8081,http://localhost:8082

# Payments (sandbox by default)
PAYMENTS_SANDBOX=true
OZOW_SITE_CODE=TEST-SITE
OZOW_PRIVATE_KEY=
YOCO_PUBLIC_KEY=pk_test_kasieats
YOCO_SECRET_KEY=

# Push notifications (optional — in-app polling works without this)
FIREBASE_PROJECT_ID=

# SMS (dev | twilio | africas_talking)
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
