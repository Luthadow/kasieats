# ──────────────────────────────────────────────────────────────────────────────
# KasiEats — Root environment variables
# Copy this file to .env.local (never commit real credentials)
#
# BUSINESS MODEL: KasiEats earns R350/month vendor subscriptions ONLY.
# Food order payments go directly from customers to vendors.
# KasiEats does NOT process food payments.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://kasieats_user:kasieats_password@localhost:5432/kasieats

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://kasieats_user:kasieats_password@localhost:5672

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:8081

# ─── SMS / OTP ────────────────────────────────────────────────────────────────
# console  → prints OTP to server logs (dev/test)
# twilio   → requires TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

OTP_EXPIRY_SECONDS=300

# ─── Vendor Subscription Billing (Ozow) ───────────────────────────────────────
# KasiEats charges vendors R350/month for access to the platform.
# Ozow is used ONLY for vendor subscription billing.
# Food order checkout is NOT processed through KasiEats.
#
# PAYMENT_MODE=sandbox     → mock Ozow flow (dev/test, safe to run without credentials)
# PAYMENT_MODE=production  → real Ozow (requires OZOW_MERCHANT_ID + OZOW_PRIVATE_KEY)
PAYMENT_MODE=sandbox
OZOW_MERCHANT_ID=
OZOW_PRIVATE_KEY=
OZOW_API_URL=https://pay.ozow.com

# ─── Storage ──────────────────────────────────────────────────────────────────
# local  → serve from filesystem (dev)
# gcs    → Google Cloud Storage
STORAGE_PROVIDER=local
GCS_BUCKET=
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Maps / Geolocation ───────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
