{
  "name": "kasieats",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:migrate": "yarn workspace @kasieats/db db:migrate",
    "db:migrate:deploy": "yarn workspace @kasieats/db db:migrate:deploy",
    "db:seed": "yarn workspace @kasieats/db db:seed",
    "db:generate": "yarn workspace @kasieats/db db:generate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "dev:infra": "docker compose up -d postgres redis rabbitmq",
    "smoke": "bash scripts/smoke-test.sh",
    "e2e": "bash scripts/e2e-order-flow.sh"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.22"
}
